# Example secrets file
# DO NOT commit this file with actual secrets!
# Copy to secrets.yaml and fill in your values

apiVersion: v1
kind: Secret
metadata:
  name: avocadodb-secrets
  labels:
    app: avocadodb
type: Opaque
stringData:
  # OpenAI API key (if using OpenAI embeddings)
  openai_api_key: "sk-your-api-key-here"

  # Other sensitive configuration
  # database_password: "your-password"

---
# To create secret from command line:
# kubectl create secret generic avocadodb-secrets \
#   --from-literal=openai_api_key=sk-your-key-here

# To create secret from file:
# kubectl create secret generic avocadodb-secrets \
#   --from-file=openai_api_key=./openai.key

# To use sealed secrets (recommended for GitOps):
# 1. Install sealed-secrets controller
# 2. Create secret and seal it:
#    kubectl create secret generic avocadodb-secrets \
#      --from-literal=openai_api_key=sk-key --dry-run=client -o yaml | \
#      kubeseal -o yaml > sealed-secret.yaml
